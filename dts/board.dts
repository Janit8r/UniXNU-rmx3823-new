/dts-v1/;
/include/ "sm8550.dtsi"

/*
 * realme GT5 240W (RMX3823), Qualcomm kalama / SM8550.
 *
 * Verified on the device (adb, user build, no root):
 *   soc_id 519, machine KALAMA, revision 2.0, page size 4096
 *   8 cores: 3x A510 + 2x A710 + 2x A715 + 1x X3
 *   GPU Adreno740v2, 23645600 kB MemTotal, panel 1240x2772 @ 560 dpi
 *
 * Board overlay reference: dtbo entry 1/2 of the stock dtbo.img
 * ("Qualcomm Technologies, Inc. Kalama MTP,zonda-A/B"), whose qcom,msm-id
 * contains 0x207 (519). 167 fragments: PM8550/PM8550B/PM8550VE_F/PM8550VS/
 * PM8010/PMK8550/PMR735D regulators, MDSS DSI ctrl0/1 and PHY0/1.
 *
 * Values marked REQUIRED are not established yet and must not be trusted.
 */

/ {
    model = "realme GT5 240W (RMX3823)";
    compatible = "realme,rmx3823", "qcom,sm8550";

    /* REQUIRED: confirm base and size against the ABL memory map before booting.
     * The base comes from the reserved-memory names on the device, which start at
     * gunyah_hyp_region@80000000. The size assumes the 24 GiB SKU. */
    memory@80000000 {
        device_type = "memory";
        reg = <0 0x80000000 0 0x600000000>;
    };

    reserved-memory {
        #address-cells = <2>;
        #size-cells = <2>;
        ranges;

        /* Command DB that ShengGmuCommandDbInputs parses. Address is read from the
         * device; REQUIRED: confirm the size from the firmware device tree. */
        aop_cmd_db_region@81c60000 {
            reg = <0 0x81c60000 0 0x20000>;
            no-map;
        };

        /* GPU microcode (ZAP) region. Address is read from the device;
         * REQUIRED: confirm the size and the consumer before enabling the GPU. */
        gpu_micro_code_region@9b09a000 {
            reg = <0 0x9b09a000 0 0x2000>;
            no-map;
        };

        /* Shared memory for SMEM. Address is read from the device;
         * REQUIRED: confirm the size. */
        smem_region@81d00000 {
            reg = <0 0x81d00000 0 0x400000>;
            no-map;
        };
    };
};

/*
 * Region inventory still to be placed, taken from the device's
 * /sys/firmware/devicetree/base/reserved-memory listing (addresses only, sizes
 * unknown): gunyah_hyp@80000000, cpusys_vm@80a00000, xbl_dt_log_merged@81a00000,
 * aop_config_merged@81c80000, chipinfo@81cf4000, adsp_mhi@81f00000,
 * global_sync@82600000, tz_stat@82700000, mpss@89800000, ipa_fw@9b080000,
 * ipa_gsi@9b090000, q6_mpss_dtb@9b000000, camera@9b300000, spss@9b100000,
 * video@9bb00000, cvp@9c200000, cdsp@9c900000, adspslpi@9ea00000,
 * q6_cdsp_dtb@9e900000, q6_adsp_dtb@9e980000, mpss_dsm@d4d00000,
 * xbl_sc@d8100000, cpucp_fw@d8140000, qtee@d8300000, oem_vm@f7c00000,
 * oem_vm_swiotlb@f7b00000, trust_ui_vm@f3800000, llcc_lpi@ff800000.
 */

/* Shared nodes are disabled in sm8550.dtsi; this board enables them. */
&ufs {
    status = "okay";
};

&ufsphy {
    status = "okay";
};

&gpu {
    status = "okay";
};

&gmu {
    status = "okay";
};

&gpu_smmu {
    status = "okay";
};
